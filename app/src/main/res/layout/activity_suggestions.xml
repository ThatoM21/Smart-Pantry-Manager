<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvReadyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to cook (you have every ingredient)"
        android:textColor="#2E7D32"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="No recipes match your pantry yet - add more ingredients"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listReady"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvAlmostHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Almost there (missing 1 to 3 ingredients)"
        android:textColor="#E65100"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/listAlmost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
